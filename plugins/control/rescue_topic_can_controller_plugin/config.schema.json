{
  "type": "object",
  "properties": {
    "can_transport": {
      "type": "string",
      "title": "CAN transport",
      "enum": ["socketcan", "slcan", "dry_run"],
      "default": "socketcan",
      "description": "socketcan uses Linux can0 and works offline. slcan uses a serial CAN adapter. dry_run publishes frames without sending hardware CAN."
    },
    "dry_run": {
      "type": "boolean",
      "title": "Dry run",
      "default": false,
      "description": "When enabled, the plugin publishes CAN TX topics but does not touch hardware."
    },
    "socketcan_interface": {
      "type": "string",
      "title": "SocketCAN interface",
      "default": "can0"
    },
    "serial_port": {
      "type": "string",
      "title": "Serial CAN port",
      "default": "/dev/ttyS5",
      "description": "Used only in slcan mode. Keep this configurable for Orange Pi 5 Pro RX/TX wiring or a serial CAN module. Do not hardcode ttyS1/ttyS2 if those pins are unavailable."
    },
    "serial_baudrate": {
      "type": "integer",
      "title": "Serial baudrate",
      "default": 1000000,
      "minimum": 9600
    },
    "slcan_setup_enabled": {
      "type": "boolean",
      "title": "Send SLCAN open commands",
      "default": false
    },
    "slcan_bitrate_code": {
      "type": "string",
      "title": "SLCAN bitrate code",
      "default": "S6",
      "description": "Common SLCAN codes: S4=125k, S5=250k, S6=500k, S8=1M."
    },
    "can_id_heartbeat": {
      "type": "string",
      "title": "Heartbeat CAN ID",
      "default": "0x100"
    },
    "can_id_motion": {
      "type": "string",
      "title": "Motion CAN ID",
      "default": "0x110"
    },
    "motion_dlc": {
      "type": "integer",
      "title": "Motion frame DLC",
      "enum": [3, 8],
      "default": 3
    },
    "heartbeat_hz": {
      "type": "number",
      "title": "Heartbeat Hz",
      "default": 10,
      "minimum": 1,
      "maximum": 50
    },
    "command_hz": {
      "type": "number",
      "title": "Motion command Hz",
      "default": 20,
      "minimum": 1,
      "maximum": 100
    },
    "mode": {
      "type": "string",
      "title": "Heartbeat mode",
      "enum": ["IDLE", "AUTO", "MANUAL", "TEST"],
      "default": "AUTO"
    },
    "enable_motion": {
      "type": "boolean",
      "title": "Enable motion flag",
      "default": true
    },
    "enable_servo": {
      "type": "boolean",
      "title": "Enable servo flag",
      "default": true
    },
    "vision_target_topic": {
      "type": "string",
      "title": "YOLO current target topic",
      "default": "astrbotex_ros2_vision_plugin.current_target"
    },
    "perception_topic": {
      "type": "string",
      "title": "Lidar perception topic",
      "default": "lidar_pose_plugin.rescue_perception"
    },
    "target_x_deadband": {
      "type": "number",
      "title": "Target x deadband",
      "default": 0.1,
      "minimum": 0,
      "maximum": 1
    },
    "capture_distance_mm": {
      "type": "number",
      "title": "Capture distance mm",
      "default": 120.0,
      "minimum": 1
    },
    "heading_error_threshold_deg": {
      "type": "number",
      "title": "Home heading threshold deg",
      "default": 8.0,
      "minimum": 0.5
    },
    "home_distance_threshold_mm": {
      "type": "number",
      "title": "Home distance threshold mm",
      "default": 250.0,
      "minimum": 1
    },
    "capture_hold_sec": {
      "type": "number",
      "title": "Capture hold seconds",
      "default": 0.8,
      "minimum": 0
    },
    "drop_hold_sec": {
      "type": "number",
      "title": "Drop hold seconds",
      "default": 0.8,
      "minimum": 0
    },
    "retreat_duration_sec": {
      "type": "number",
      "title": "Retreat seconds",
      "default": 3.0,
      "minimum": 0
    },
    "target_x_positive_turn": {
      "type": "string",
      "title": "target_x positive turn direction",
      "enum": ["right", "left"],
      "default": "right"
    },
    "heading_error_positive_turn": {
      "type": "string",
      "title": "heading error positive turn direction",
      "enum": ["left", "right"],
      "default": "left"
    },
    "scan_turn": {
      "type": "string",
      "title": "Search turn direction",
      "enum": ["right", "left"],
      "default": "right"
    },
    "stop_on_boundary_risk": {
      "type": "boolean",
      "title": "Stop on boundary risk",
      "default": true
    },
    "ignore_own_safe_zone_targets": {
      "type": "boolean",
      "title": "忽略本方安全区内目标",
      "default": true,
      "description": "开启后，如果雷达插件标记 selected_target_ignore 或 selected_target_in_own_safe_zone，CAN 控制插件会继续搜索，不会接近或收球。"
    },
    "servo_release_value": {
      "type": "integer",
      "title": "Servo release value",
      "enum": [0, 1],
      "default": 0
    },
    "servo_capture_value": {
      "type": "integer",
      "title": "Servo capture value",
      "enum": [0, 1],
      "default": 1
    },
    "pubsub": {
      "type": "object",
      "title": "Pub/Sub",
      "properties": {
        "publish_enabled": {
          "type": "boolean",
          "title": "Enable publishing",
          "default": true
        },
        "enabled_topics": {
          "type": "array",
          "title": "Enabled topics",
          "default": [
            "rescue_topic_can_controller_plugin.state",
            "rescue_topic_can_controller_plugin.decision",
            "rescue_topic_can_controller_plugin.can_tx",
            "rescue_topic_can_controller_plugin.can_rx"
          ],
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
