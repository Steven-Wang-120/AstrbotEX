{
  "input_mode": "ros2",
  "ros_node_name": "lidar_pose_plugin",
  "scan_topic": "/scan",
  "scan_message_type": "sensor_msgs/msg/LaserScan",
  "pose_topic": "/astrbotex/robot_pose",
  "pose_message_type": "geometry_msgs/msg/Pose2D",
  "spin_timeout_sec": 0.05,
  "ipc_socket_path": "/app/data/ipc/astrbotex_lidar.sock",
  "ipc_socket_backlog": 1,
  "ipc_read_timeout_sec": 0.2,
  "stale_after_ms": 800,
  "publish_hz": 10,
  "source_name": "lidar_pose",
  "default_frame_id": "lidar_front",
  "vision_target_topic": "astrbotex_ros2_vision_plugin.current_target",
  "vision_target_stale_ms": 700,
  "camera_hfov_deg": 60.0,
  "camera_to_lidar_yaw_offset_deg": 0.0,
  "camera_x_to_lidar_angle_sign": -1.0,
  "target_range_window_deg": 3.0,
  "front_range_window_deg": 5.0,
  "range_select_method": "min",
  "pose_unit": "mm",
  "pose_yaw_unit": "rad",
  "home_x_mm": 0.0,
  "home_y_mm": 0.0,
  "target_projection_angle_mode": "robot_yaw_minus_lidar_angle",
  "ignore_own_safe_zone_targets": true,
  "own_safe_zone_min_x_mm": 0.0,
  "own_safe_zone_max_x_mm": 300.0,
  "own_safe_zone_min_y_mm": -300.0,
  "own_safe_zone_max_y_mm": 300.0,
  "own_safe_zone_margin_mm": 20.0,
  "field_min_x_mm": 0.0,
  "field_max_x_mm": 2400.0,
  "field_min_y_mm": -1200.0,
  "field_max_y_mm": 1200.0,
  "boundary_margin_mm": 120.0,
  "boundary_check_enabled": true,
  "pubsub": {
    "publish_enabled": true,
    "enabled_topics": [
      "lidar_pose_plugin.pose",
      "lidar_pose_plugin.selected_target_range",
      "lidar_pose_plugin.boundary",
      "lidar_pose_plugin.rescue_perception"
    ]
  }
}
