{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:astr-chat:0.1-draft:native-message",
  "title": "astr-chat persisted message: text, mention, reply and native image",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "message_id",
    "conversation_id",
    "sender_id",
    "client_message_id",
    "created_at",
    "recalled",
    "segments"
  ],
  "properties": {
    "protocol": {
      "const": "astr-chat/0.1-draft"
    },
    "message_id": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,9}$",
      "description": "Runtime must additionally enforce <=2147483647."
    },
    "conversation_id": {
      "type": "string",
      "format": "uuid"
    },
    "sender_id": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,9}$",
      "description": "Runtime must additionally enforce <=2147483647."
    },
    "client_message_id": {
      "type": "string",
      "format": "uuid"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "recalled": {
      "type": "boolean"
    },
    "segments": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "type",
              "data"
            ],
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "text"
              },
              "data": {
                "type": "object",
                "required": [
                  "text"
                ],
                "additionalProperties": false,
                "properties": {
                  "text": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4000
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "required": [
              "type",
              "data"
            ],
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "mention"
              },
              "data": {
                "type": "object",
                "required": [
                  "user_id"
                ],
                "additionalProperties": false,
                "properties": {
                  "user_id": {
                    "oneOf": [
                      {
                        "type": "string",
                        "pattern": "^[1-9][0-9]{0,9}$",
                        "description": "Runtime must additionally enforce <=2147483647."
                      },
                      {
                        "const": "all"
                      }
                    ]
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "required": [
              "type",
              "data"
            ],
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "reply"
              },
              "data": {
                "type": "object",
                "required": [
                  "message_id"
                ],
                "additionalProperties": false,
                "properties": {
                  "message_id": {
                    "type": "string",
                    "pattern": "^[1-9][0-9]{0,9}$",
                    "description": "Runtime must additionally enforce <=2147483647."
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "required": [
              "type",
              "data"
            ],
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "image"
              },
              "data": {
                "type": "object",
                "required": [
                  "media_id"
                ],
                "additionalProperties": false,
                "properties": {
                  "media_id": {
                    "type": "string",
                    "format": "uuid",
                    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                  }
                }
              }
            }
          }
        ]
      },
      "maxItems": 16,
      "description": "Runtime enforces total text <=4000 code points, ID upper bounds, current membership and same-conversation available reply targets.",
      "contains": {
        "type": "object",
        "properties": {
          "type": {
            "const": "reply"
          }
        },
        "required": [
          "type"
        ]
      },
      "minContains": 0,
      "maxContains": 1
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "recalled": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "segments": {
            "maxItems": 0
          }
        }
      },
      "else": {
        "properties": {
          "segments": {
            "minItems": 1,
            "contains": {
              "properties": {
                "type": {
                  "enum": [
                    "text",
                    "mention",
                    "image"
                  ]
                }
              },
              "required": [
                "type"
              ]
            },
            "minContains": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "segments": {
            "contains": {
              "properties": {
                "type": {
                  "const": "reply"
                }
              },
              "required": [
                "type"
              ]
            }
          }
        }
      },
      "then": {
        "properties": {
          "segments": {
            "prefixItems": [
              {
                "properties": {
                  "type": {
                    "const": "reply"
                  }
                }
              }
            ]
          }
        }
      }
    }
  ]
}
