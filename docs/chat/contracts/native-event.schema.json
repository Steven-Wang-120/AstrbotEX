{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:astr-chat:0.1-draft:native-event",
  "title": "astr-chat account event draft",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "event_id",
    "seq",
    "cursor",
    "type",
    "occurred_at",
    "payload"
  ],
  "properties": {
    "protocol": {
      "const": "astr-chat/0.1-draft"
    },
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "seq": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$"
    },
    "cursor": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "enum": [
        "message.created",
        "message.recalled",
        "conversation.updated",
        "read.updated",
        "profile.updated",
        "post.created",
        "post.updated",
        "post.deleted"
      ]
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "payload": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "message.created"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": [
              "message"
            ],
            "additionalProperties": false,
            "properties": {
              "message": {
                "$ref": "urn:astr-chat:0.1-draft:native-message"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "message.recalled"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": [
              "message_id",
              "conversation_id"
            ],
            "additionalProperties": false,
            "properties": {
              "message_id": {
                "type": "string",
                "pattern": "^[1-9][0-9]{0,9}$",
                "description": "Runtime must additionally enforce <=2147483647."
              },
              "conversation_id": {
                "type": "string",
                "format": "uuid"
              }
            }
          }
        }
      }
    }
  ]
}
