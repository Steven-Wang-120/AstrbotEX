        ],
        "title": "DirectRequest"
      },
      "GroupRequest": {
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Title"
          },
          "member_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 100,
            "title": "Member Ids"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
