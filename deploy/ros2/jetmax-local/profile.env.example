# JetMax local (single host) ROS 2 profile - EXAMPLE, opt-in, not auto-applied.
#
# Copy next to the EX service environment (for example /etc/astrex/ros2.env),
# replace every <PLACEHOLDER>, then start the EX service with this file loaded.
# Nothing in this repository enables it for you.
#
# Validated on 2026-10-30 on the JetMax host: EX, camera and YOLO entry all on
# rmw_cyclonedds_cpp, Domain 0, ROS_LOCALHOST_ONLY=1, loopback multicast on.
# That run proves this combination worked *on that host*. It does not prove
# Cyclone is required in general, does not identify a Fast DDS defect, and does
# not make loopback multicast the single root cause.

# Domain 0 is the value verified on the JetMax site. It is NOT a test domain:
# acceptance runs use an isolated domain (73 by default) instead.
ROS_DOMAIN_ID=0

# Single host only. Every producer (run-camera, run-yolo, EX) must see this.
# Do NOT use this for a multi-machine deployment: see README "cross machine".
ROS_LOCALHOST_ONLY=1

# Must be installed on the target distribution (ros-<distro>-rmw-cyclonedds-cpp).
RMW_IMPLEMENTATION=rmw_cyclonedds_cpp

# Optional: pin the Cyclone profile file written by the drop-in example.
# Leave commented out to use the RMW defaults.
#CYCLONEDDS_URI=file:///etc/astrex/cyclonedds.xml

# Optional: EX overlay that provides the robot interfaces.
#ASTRBOTEX_ROS_OVERLAY=/opt/robot_overlay
